# Copy to /etc/audiostream.env (chmod 600). Read by the systemd service.

# Folders to browse. Repeat --root for each one.
AUDIOSTREAM_ROOTS=--root /home/you/Music --root /home/you/Audiobooks

# Port to listen on
AUDIOSTREAM_PORT=8000

# Uncomment to require a password (any username, this password)
#AUDIOSTREAM_PASSWORD=changeme
